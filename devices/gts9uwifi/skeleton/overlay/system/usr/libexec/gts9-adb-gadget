#!/bin/sh
# Static ADB-only USB gadget, bypassing usb-moded (broken mode system on this
# image). Deterministic ordering to avoid the enumerate race:
#   build gadget -> mount functionfs (uid=phablet) -> start adbd (writes
#   descriptors, creates ep1/ep2) -> wait for endpoints -> bind UDC.
G=/sys/kernel/config/usb_gadget/g1
LOG=/var/log/gts9-adb.log
log() { echo "$(cat /proc/uptime 2>/dev/null | cut -d' ' -f1) $*" >> "$LOG"; }
# the dwc3 UDC registers from a vendor module, which can land after this
# unit starts; wait for one rather than binding into the void
i=0
while [ "$i" -lt 75 ]; do
    UDC=$(ls /sys/class/udc 2>/dev/null | grep dwc3 | head -1)
    [ -n "$UDC" ] || UDC=$(ls /sys/class/udc 2>/dev/null | head -1)
    [ -n "$UDC" ] && break
    sleep 0.2
    i=$((i + 1))
done
log "start: udc=$UDC (waited $i)"

# usb-moded ignores the /etc mask on this image and keeps rebinding its own
# gadget over ours; runtime-mask it in /run (highest precedence), stop and kill
# it so it cannot clobber the adb gadget.
mkdir -p /run/systemd/system 2>/dev/null
ln -sf /dev/null /run/systemd/system/usb-moded.service 2>/dev/null
systemctl daemon-reload 2>/dev/null
systemctl stop usb-moded.service 2>/dev/null
pkill -9 usb_moded 2>/dev/null

mountpoint -q /sys/kernel/config || mount -t configfs none /sys/kernel/config 2>/dev/null
[ -w "$G/UDC" ] && echo "" > "$G/UDC" 2>/dev/null

# usb-moded may have linked its own functions into the config before we
# stopped it; a dead ffs function in there holds off the whole gadget
for f in "$G"/configs/c.1/*.*; do
    [ -L "$f" ] && rm "$f" 2>/dev/null
done

mkdir -p "$G/strings/0x409" "$G/configs/c.1/strings/0x409" "$G/functions/ffs.adb" 2>/dev/null
echo 0x18d1 > "$G/idVendor" 2>/dev/null
echo 0x4ee7 > "$G/idProduct" 2>/dev/null
echo 0x0200 > "$G/bcdUSB" 2>/dev/null
echo "$(getprop ro.serialno 2>/dev/null || echo gts9uwifi)" > "$G/strings/0x409/serialnumber" 2>/dev/null
echo "Samsung" > "$G/strings/0x409/manufacturer" 2>/dev/null
echo "SM-X910" > "$G/strings/0x409/product" 2>/dev/null
echo "adb" > "$G/configs/c.1/strings/0x409/configuration" 2>/dev/null
echo 500 > "$G/configs/c.1/MaxPower" 2>/dev/null
[ -e "$G/configs/c.1/ffs.adb" ] || ln -s "$G/functions/ffs.adb" "$G/configs/c.1/" 2>/dev/null
mkdir -p "$G/functions/ffs.mtp" 2>/dev/null

# functionfs must be owned by phablet: adbd runs as phablet and opens ep0.
mkdir -p /dev/usb-ffs/adb 2>/dev/null
chown phablet:phablet /dev/usb-ffs /dev/usb-ffs/adb 2>/dev/null
mountpoint -q /dev/usb-ffs/adb || mount -t functionfs adb /dev/usb-ffs/adb -o uid=phablet,gid=phablet 2>/dev/null

# adbd opens ep0 and writes descriptors, which makes ep1/ep2 appear.
systemctl start adbd.service

# same dance for umtprd; mtp only joins the config once its endpoints exist,
# a descriptor-less ffs function in the config would hold off the whole gadget.
systemctl start --no-block umtprd.service
i=0
while [ "$i" -lt 50 ]; do
    [ -e /dev/usb-ffs/mtp/ep1 ] && break
    sleep 0.2
    i=$((i + 1))
done
log "mtp ep1 wait: i=$i present=$([ -e /dev/usb-ffs/mtp/ep1 ] && echo yes || echo no)"
if [ -e /dev/usb-ffs/mtp/ep1 ]; then
    [ -e "$G/configs/c.1/ffs.mtp" ] || ln -s "$G/functions/ffs.mtp" "$G/configs/c.1/" 2>/dev/null
    echo 0x4ee2 > "$G/idProduct" 2>/dev/null
else
    systemctl stop umtprd.service 2>/dev/null
fi

# Only bind the UDC once adbd has initialised the function (ep1 present),
# otherwise enumeration races and the host sees nothing.
i=0
while [ "$i" -lt 50 ]; do
    [ -e /dev/usb-ffs/adb/ep1 ] && break
    sleep 0.2
    i=$((i + 1))
done
log "ep1 wait: i=$i present=$([ -e /dev/usb-ffs/adb/ep1 ] && echo yes || echo no)"
i=0
while [ "$i" -lt 3 ]; do
    echo "$UDC" > "$G/UDC" 2>/dev/null
    [ -n "$(cat "$G/UDC" 2>/dev/null)" ] && break
    sleep 1
    i=$((i + 1))
done
log "udc bound: $(cat "$G/UDC" 2>/dev/null)"

# dwc3-msm keeps the session off until a vbus/typec event; the Samsung
# typec/muic notifiers never deliver one here, so force peripheral mode on
# the wrapper to start the gadget session (pullup).
for m in /sys/devices/platform/soc/*.ssusb/mode; do
    [ -w "$m" ] || continue
    log "mode $m: was=$(cat "$m" 2>/dev/null)"
    echo peripheral > "$m" 2>/dev/null
    log "mode $m: now=$(cat "$m" 2>/dev/null)"
done
log "udc state: $(cat /sys/class/udc/$UDC/state 2>/dev/null)"
[ -n "$(cat "$G/UDC" 2>/dev/null)" ] || { log "udc bind failed"; exit 1; }
exit 0
