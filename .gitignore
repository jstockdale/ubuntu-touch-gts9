# Samsung/Qualcomm proprietary blobs and firmware — never commit.
# Kept on local disk for the snapshot; see archive/binaries/MANIFEST.md for hashes.
archive/binaries/*
!archive/binaries/MANIFEST.md
archive/osrc/*
!archive/osrc/.gitkeep

# Firmware donors and build output (regenerated by tools/extract/*.sh and the build scripts)
out-*/
*.img
super.img*
*.tar.xz
workdir/
partitions/
gts9?-build/
ubuntu-touch-gts9*wifi-*.zip

# Skeleton payload is part of the device repo, never a build output —
# exempt it from the *.img build-artifact rule wholesale.
!devices/*/skeleton/**/*.img
!devices/*/skeleton/vbmeta.img
